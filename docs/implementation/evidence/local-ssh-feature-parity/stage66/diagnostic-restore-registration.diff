+test("direct restore registers only the matching execution for port scanning and hints only from live output", async () => {
+	const f = await fixture(false);
+	expect(f.portSessions).toEqual([["terminal", "workspace", 123]]);
+	expect(f.portHints).toEqual([]);
+	f.replay.onOutput(Buffer.from("historical listening on port 3000"));
+	expect(f.portHints).toEqual([]);
+	f.replay.onReplayComplete?.(f.snapshot);
+	f.replay.onOutput(Buffer.from("server listening on port 3000"));
+	expect(f.portHints).toEqual([["terminal", "server listening on port 3000"]]);
+	f.close();
+	f.replay.onOutput(Buffer.from("closed output"));
+	expect(f.portHints).toHaveLength(1);
+	const other = await fixture(true, "other-execution");
+	expect(other.portSessions).toEqual([]);
+	other.close();
+});
